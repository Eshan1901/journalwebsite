# Environment Variables for JCIDS Journal
# Copy to .env for local development

# Server Configuration
PORT=3001
NODE_ENV=development

# API Configuration
API_BASE_URL=http://localhost:3001

# Email Configuration (if implementing actual email sending)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password

# Database (if switching from in-memory to persistent storage)
DATABASE_URL=your-database-url

# Security
JWT_SECRET=your-jwt-secret-for-admin-auth

# Deployment URLs
VERCEL_URL=your-vercel-app-url
NETLIFY_URL=your-netlify-app-url
HEROKU_URL=your-heroku-app-url